# Maintainer: Ryan <ryan@freyja.pw>
pkgname=kdeck-control-git
_pkgname=kdeck-control
pkgver=1.1.0.r6.g5fa4674
pkgrel=1
pkgdesc="Stream Deck support for the Corsair Galleon 100 SD keyboard: LCD keys, top screen, dials, per-game profiles"
arch=('any')
url="https://github.com/RyanHakurei/KDEck-Control"
license=('MIT')
depends=('python' 'python-pillow' 'python-evdev' 'python-gobject' 'gtk4' 'libadwaita'
         'ttf-nerd-fonts-symbols' 'ttf-jetbrains-mono')
makedepends=('git')
optdepends=('python-fonttools: icon search in the configurator'
            'playerctl: now-playing on the top screen and media keys'
            'libnotify: desktop notifications'
            'wireplumber: volume dial (PipeWire)'
            'libpulse: volume dial (PulseAudio)')
provides=("$_pkgname")
conflicts=("$_pkgname" 'kdeck-control-local'
           'galleon-deck' 'galleon-deck-git' 'galleon-deck-local' 'galleon-deck-qt')
replaces=('galleon-deck-git')
install=kdeck-control.install
source=("KDEck-Control::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd KDEck-Control
  git describe --long --tags --abbrev=7 | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

package() {
  cd KDEck-Control
  install -Dm644 -t "$pkgdir/usr/share/$_pkgname" src/*.py
  cp -r examples "$pkgdir/usr/share/$_pkgname/examples"
  install -Dm755 -t "$pkgdir/usr/bin" bin/kdeck-control bin/kdeck-control-config bin/kdeck-addon

  install -Dm644 data/applications/org.kde.kdeckcontrol.desktop \
    "$pkgdir/usr/share/applications/org.kde.kdeckcontrol.desktop"
  install -Dm644 data/udev/71-kdeck-control.rules "$pkgdir/usr/lib/udev/rules.d/71-kdeck-control.rules"
  install -dm755 "$pkgdir/usr/lib/modules-load.d"
  echo uinput > "$pkgdir/usr/lib/modules-load.d/kdeck-control.conf"
  sed 's|^ExecStart=.*|ExecStart=/usr/bin/kdeck-control|' data/systemd/kdeck-control.service \
    | install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/user/kdeck-control.service"

  install -Dm644 README.md "$pkgdir/usr/share/doc/$_pkgname/README.md"
  install -Dm644 docs/PROTOCOL.md "$pkgdir/usr/share/doc/$_pkgname/PROTOCOL.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
