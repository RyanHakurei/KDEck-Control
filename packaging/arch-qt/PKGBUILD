# Local C++/Kirigami package of this working tree, including uncommitted changes.
# packaging/arch clones GitHub. packaging/arch-local packages the Python app.
# Build from this directory: makepkg -f
pkgname=galleon-deck-qt
_pkgname=galleon-deck
pkgver=1.3.0.r12.gdcf6e44.dirty
pkgrel=9
pkgdesc="Stream Deck support for the Corsair Galleon 100 SD keyboard (C++ and Kirigami)"
arch=('x86_64')
url="https://github.com/NLMP-DDHS/galleon-deck"
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'qt6-svg' 'qt6-imageformats'
         'kirigami' 'kirigami-addons' 'qqc2-desktop-style'
         'ki18n' 'kcoreaddons' 'kiconthemes' 'breeze-icons'
         'libevdev' 'ttf-nerd-fonts-symbols' 'ttf-jetbrains-mono'
         'python' 'python-pillow' 'python-evdev'
         'ksystemstats')
makedepends=('cmake' 'extra-cmake-modules' 'git' 'ninja' 'pkgconf' 'tomlplusplus')
optdepends=('playerctl: media keys and now playing on the clock screen'
            'wireplumber: volume dial (PipeWire)'
            'libpulse: volume dial (PulseAudio)')
provides=("$_pkgname")
conflicts=("$_pkgname" "$_pkgname-git" "$_pkgname-local")
replaces=("$_pkgname-local")
install=galleon-deck.install

pkgver() {
  cd "$_pkgname"
  git describe --long --tags --abbrev=7 --dirty | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
  local repo
  repo="$(cd "$startdir/../.." && pwd)"
  rm -rf "$srcdir/$_pkgname"
  mkdir -p "$srcdir/$_pkgname"
  tar -C "$repo" -cf - \
    --exclude='./packaging/arch/src' \
    --exclude='./packaging/arch/pkg' \
    --exclude='./packaging/arch/galleon-deck' \
    --exclude='./packaging/arch/*.pkg.tar.*' \
    --exclude='./packaging/arch-local/src' \
    --exclude='./packaging/arch-local/pkg' \
    --exclude='./packaging/arch-local/*.pkg.tar.*' \
    --exclude='./packaging/arch-qt/src' \
    --exclude='./packaging/arch-qt/pkg' \
    --exclude='./packaging/arch-qt/*.pkg.tar.*' \
    --exclude='./cpp/build' \
    --exclude='__pycache__' \
    --exclude='*.pyc' \
    --exclude='*.zip' \
    . | tar -C "$srcdir/$_pkgname" -xf -
}

build() {
  cmake -S "$srcdir/$_pkgname/cpp" -B "$srcdir/build" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DGALLEAN_EMBED_SOURCE_EXAMPLES=OFF
  cmake --build "$srcdir/build"
}

package() {
  DESTDIR="$pkgdir" cmake --install "$srcdir/build"

  install -Dm644 "$srcdir/$_pkgname/data/udev/71-galleon-deck.rules" \
    "$pkgdir/usr/lib/udev/rules.d/71-galleon-deck.rules"
  install -dm755 "$pkgdir/usr/lib/modules-load.d"
  echo uinput > "$pkgdir/usr/lib/modules-load.d/galleon-deck.conf"
  # The service draws with QPainter and does not open a window. offscreen
  # keeps it from needing the session's Wayland socket.
  sed -e 's|^ExecStart=.*|ExecStart=/usr/bin/galleon-deck|' \
      -e '/^\[Service\]/a Environment=QT_QPA_PLATFORM=offscreen' \
      "$srcdir/$_pkgname/data/systemd/galleon-deck.service" \
    | install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/user/galleon-deck.service"

  install -Dm644 "$srcdir/$_pkgname/README.md" "$pkgdir/usr/share/doc/$_pkgname/README.md"
  install -Dm644 "$srcdir/$_pkgname/docs/PROTOCOL.md" "$pkgdir/usr/share/doc/$_pkgname/PROTOCOL.md"
  install -Dm644 "$srcdir/$_pkgname/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
