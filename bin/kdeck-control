#!/bin/sh
# Stream Deck service for the Corsair Galleon 100 SD. Resolves its install
# location through symlinks so it works from ~/.local/bin or a git checkout.
here=$(dirname "$(readlink -f "$0")")
# The distro Python has the packaged modules; a conda/pyenv/venv python3
# earlier on PATH usually doesn't.
py=/usr/bin/python3; [ -x "$py" ] || py=python3
for src in "$here/../src" "$here/../share/kdeck-control" "${XDG_DATA_HOME:-$HOME/.local/share}/kdeck-control"; do
    [ -f "$src/kdeck_control.py" ] && exec "$py" "$src/kdeck_control.py" "$@"
done
echo "kdeck-control: can't find kdeck_control.py" >&2
exit 1
